PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
CORS_ORIGIN=http://localhost:5173

# Optional: SMS via Semaphore (https://semaphore.co) - popular PH SMS gateway, pay-per-SMS, no USD billing needed
SEMAPHORE_API_KEY=

# Optional: Email via Gmail SMTP (use an App Password, not your real password) or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TheraConnect <no-reply@theraconnect.ph>"

# Optional: OpenAI note drafting through the backend only. Never expose this key in the frontend.
# Leave OPENAI_API_KEY blank to keep note drafting local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Alternative clinic-approved AI note service (used only when OPENAI_API_KEY is blank).
# The endpoint receives de-identified raw notes and treatment goal metadata as JSON.
AI_NOTES_ENDPOINT=
AI_NOTES_API_KEY=
